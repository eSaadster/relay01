# relay01 configuration
# Copy this file to .env and fill in your Slack app credentials.

# Required: Slack Socket Mode app token (xapp-...) and bot token (xoxb-...)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Optional: agent model / behavior overrides
# PI_AGENT_MODEL=claude-sonnet-4-6
# PI_THINKING_LEVEL=off
# PI_TIMEOUT_MS=120000

# Optional: dashboard/control API port (default 3456)
# DASHBOARD_BRIDGE_PORT=3456

# Optional: let the agent read and write shared memory via the memory_query /
# memory_write tools. Off by default — global memory is injected into every
# session's prompt, so anything written here is visible workspace-wide.
# Writes go to a review inbox and are merged by the consolidation pass, never
# straight into MEMORY.md. User-scoped memory stays DM-only either way.
# USE_MEMORY_TOOLS=true
