# relay01 configuration
# Copy this file to .env and fill in your Slack app credentials.

# Required: Slack Socket Mode app token (xapp-...) and bot token (xoxb-...)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# Optional: agent model / behavior overrides
# PI_AGENT_MODEL=claude-sonnet-4-6
# PI_THINKING_LEVEL=off
# PI_TIMEOUT_MS=120000

# Optional: dashboard/control API port (default 3456)
# DASHBOARD_BRIDGE_PORT=3456
